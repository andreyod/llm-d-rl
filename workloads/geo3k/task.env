# geo3k (multimodal, Qwen2.5-VL-7B). Data via verl's own geo3k preprocess (no custom builder).
# The VL launch script hardcodes data.train_files/val_files, so we pass them on the CLI.
# Synthetic test: GEO3K_IMG_TOKENS upscales every image to a fixed (large) token count (min=max
# pixels, 784 px per visual token; native geo3k diagrams are tiny) - used to investigate the impact
# of large multimodal prompt prefixes on rollout performance.
FSDP_SCRIPT=run_qwen2_5_vl_7b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen2.5-VL-7B-Instruct
DEF_PROJECT=verl_grpo_geo3k
DEF_TRAIN=/tmp/verl/data/geo3k/train.parquet
DEF_TEST=/tmp/verl/data/geo3k/test.parquet
DEF_MAXP=8192; DEF_MAXR=256

# Resolve data files here (honor TRAIN_FILE/TEST_FILE) since the VL script needs them on the CLI.
_geo_train=${TRAIN_FILE:-$DEF_TRAIN}
_geo_test=${TEST_FILE:-$DEF_TEST}
GEO3K_IMG_TOKENS=${GEO3K_IMG_TOKENS:-4096}
GEO3K_IMG_PIXELS=$(( GEO3K_IMG_TOKENS * 784 ))   # 784 = 28*28 pixels per visual token
GEO3K_TRAIN_BATCH=${GEO3K_TRAIN_BATCH:-64}
# actor.strategy=fsdp (FSDP1): the VL script forces fsdp2 + fused kernels, which trips a mixed
# torch.Tensor/DTensor error in compute_log_prob (verl #5633); FSDP1 avoids it, fused kernels stay on.
# filter_overlong_prompts=False + smaller train_batch_size keep the driver's image-tensor RAM
# footprint down during validation (avoid OOM). min/max_pixels forwarded to training and vLLM alike.
TASK_OVERRIDES=(data.train_files="$_geo_train" data.val_files="$_geo_test" data.image_key=images
  actor_rollout_ref.actor.strategy=fsdp
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=16384
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=16384
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=16384
  +data.mm_processor_kwargs.min_pixels=$GEO3K_IMG_PIXELS
  +data.mm_processor_kwargs.max_pixels=$GEO3K_IMG_PIXELS
  data.filter_overlong_prompts=False
  data.train_batch_size=$GEO3K_TRAIN_BATCH)
